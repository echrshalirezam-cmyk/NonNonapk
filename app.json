{
  "expo": {
    "name": "NonNon",
    "slug": "nonnon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nonnon",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060D24",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060D24"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.nonnon.english",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#060D24"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#060D24",
        "mdpi": "./assets/images/splash-icon.png",
        "hdpi": "./assets/images/splash-icon.png",
        "xhdpi": "./assets/images/splash-icon.png",
        "xxhdpi": "./assets/images/splash-icon.png",
        "xxxhdpi": "./assets/images/splash-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      ["expo-speech-recognition", {
        "microphonePermission": "NonNon برای تبدیل گفتار فارسی و انگلیسی به متن، به میکروفون نیاز دارد.",
        "speechRecognitionPermission": "NonNon برای تبدیل گفتار شما به متن و ترجمه آن به تشخیص گفتار نیاز دارد."
      }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
